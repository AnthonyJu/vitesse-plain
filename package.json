{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint --fix \"src/**/*.{js,jsx,ts,tsx,vue}\"",
    "lint:style": "stylelint --fix \"src/**/*.{vue,scss}\"",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "build-zip": "vite build && pick-zip -d",
    "preview": "vite preview",
    "preview-https": "serve dist",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "up": "taze major -I",
    "sizecheck": "npx vite-bundle-visualizer",
    "postinstall": "npx simple-git-hooks"
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.1",
    "element-plus": "^2.14.8",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@anthony-ju/eslint-config": "^0.2.9",
    "@anthony-ju/stylelint-config": "^0.5.0",
    "@iconify-json/carbon": "^1.2.30",
    "@playwright/test": "^1.65.1",
    "@types/node": "^25.9.1",
    "@types/nprogress": "^0.2.3",
    "@unocss/eslint-config": "^66.12.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/runtime-dom": "^3.5.45",
    "@vue/test-utils": "^2.5.1",
    "beasties": "^0.5.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-format": "^2.0.1",
    "https-localhost": "^4.7.2",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "pick-zip": "^0.2.0",
    "picocolors": "^1.1.1",
    "pnpm": "^11.5.1",
    "sass": "^1.108.2",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.12.0",
    "taze": "^21.3.0",
    "typescript": "^6.0.3",
    "unocss": "^66.12.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.8",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-devtools-json": "^1.1.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.14",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "node scripts/verify-commit.js"
  },
  "lint-staged": {
    "*.{vue,scss}": "stylelint --fix",
    "*.{js,jsx,ts,tsx,vue}": "eslint --fix"
  }
}
